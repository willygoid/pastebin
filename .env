# App mode
APP_ENV=development
APP_NAME=pastebin

# Nginx (custom domain)
NGINX_SERVER_NAME=localhost             # <-- ganti jadi domain.com bila perlu
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DEFAULT_PROTOCOL=http

# Backend (Golang)
BACKEND_PORT=8080

# Frontend (Next.js)
FRONTEND_PORT=3000
FRONTEND_URL=${DEFAULT_PROTOCOL}://frontend:${FRONTEND_PORT}
NEXT_PUBLIC_API_URL=${DEFAULT_PROTOCOL}://${NGINX_SERVER_NAME}:${NGINX_HTTP_PORT}

# Upstream (for nginx)
BACKEND_UPSTREAM_HOST=backend
BACKEND_UPSTREAM_PORT=${BACKEND_PORT}
FRONTEND_UPSTREAM_HOST=frontend
FRONTEND_UPSTREAM_PORT=${FRONTEND_PORT}

# Postgres
POSTGRES_USER=willy
POSTGRES_PASSWORD=willy1337
POSTGRES_DB=pastebin
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Optional: other secrets / envs
JWT_SECRET=your_jwt_secret_here
