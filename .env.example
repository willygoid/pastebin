# Application
APP_NAME=pastebin
APP_ENV=production
APP_PORT=3000

# Backend
BACKEND_PORT=8080
GO_ENV=production
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production

# Database
POSTGRES_USER=pastebin_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=pastebin_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Nginx
NGINX_PORT=80

# Cloudflare Tunnel
# Set USE_TUNNEL=true dan isi token dari Zero Trust Dashboard.
# Public Hostname di dashboard arahkan ke http://nginx:80.
USE_TUNNEL=false
CLOUDFLARE_TUNNEL_TOKEN=

